# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER SIDE ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── GitHub App ────────────────────────────────────────────────────────────────
# Create a GitHub App: docs/creating-a-github-app.md
# Found in: GitHub → Settings → Developer settings → GitHub Apps → your app

GITHUB_APP_ID=123456

# Paste the full RSA private key (-----BEGIN RSA PRIVATE KEY----- ... -----END RSA PRIVATE KEY-----)
# In Vercel: paste as-is (multi-line values are supported in the dashboard).
# In a .env file: replace all newlines with \n so it fits on one line.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# ── Optional ──────────────────────────────────────────────────────────────────
# How long (seconds) Vercel's CDN caches the rendered SVG. Default: 3600 (1 hour).
# RENDER_TTL_SECONDS=3600

# Override the base URL used in the embed code shown after saving a card.
# Not needed — the server auto-detects the origin from the request URL.
# Only set this if you're behind a reverse proxy that mangles the Host header.
# NEXT_PUBLIC_BASE_URL=https://pixel-profile-zeta.vercel.app
